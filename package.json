{
  "author": "Kevin De Benedetti",
  "type": "module",
  "devDependencies": {
    "@j178/prek": "^0.5.3",
    "@types/bun": "^1.3.10",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.55.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.2.5",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "postinstall": "codesign --force --sign - node_modules/@esbuild/darwin-arm64/bin/esbuild 2>/dev/null || true",
    "prepare": "prek install",
    "sync-docs": "bun scripts/sync-docs.ts",
    "dev": "bun run generate && vitepress dev",
    "build": "bun run generate && vitepress build",
    "preview": "vitepress preview",
    "generate": "bun run sync-docs && bun scripts/generate-config.ts",
    "lint": "oxlint --tsconfig=tsconfig.json .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf node_modules dist .vitepress/dist .vitepress/cache synced"
  },
  "packageManager": "bun@1.2.21",
  "overrides": {
    "esbuild": "^0.25.0",
    "axios": "^1.20.0",
    "brace-expansion": "^2.1.7",
    "form-data": "^4.0.6",
    "js-cookie": "^3.0.8",
    "nanoid": "^3.3.19",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.28",
    "vite": "^6.4.3"
  },
  "trustedDependencies": [
    "@j178/prek"
  ]
}
